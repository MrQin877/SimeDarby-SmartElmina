# Optional MapLibre-compatible style. Default: OpenFreeMap Liberty.
EXPO_PUBLIC_MAP_STYLE_URL=
# Optional authorised HTTPS HLS feed for demo camera 01. Never put credentials here.
EXPO_PUBLIC_CCTV_STREAM_URL=

# OSRM-compatible service origin; default uses the public demo service.
EXPO_PUBLIC_ROUTING_URL=https://router.project-osrm.org

# A separately preprocessed OSRM pedestrian service (not a driving server with a renamed profile).
EXPO_PUBLIC_WALKING_ROUTING_URL=https://routing.openstreetmap.de/routed-foot
